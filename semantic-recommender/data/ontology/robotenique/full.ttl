@prefix : <http://www.ime.usp.br/~renata/FOAF-modified#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ime.usp.br/~renata/FOAF-modified> .

<http://www.ime.usp.br/~renata/FOAF-modified> rdf:type owl:Ontology ;
                                               <http://purl.org/dc/elements/1.1/description> "The Friend of a Friend (FOAF) RDF vocabulary, described using W3C RDF Schema and the Web Ontology Language." ;
                                               <http://purl.org/dc/elements/1.1/title> "Friend of a Friend (FOAF) vocabulary" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2003/06/sw-vocab-status/ns#term_status
<http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ime.usp.br/~renata/FOAF-modifiedacts
<http://www.ime.usp.br/~renata/FOAF-modifiedacts> rdf:type owl:ObjectProperty ;
                                                  rdfs:subPropertyOf owl:topObjectProperty ;
                                                  owl:inverseOf <http://www.ime.usp.br/~renata/FOAF-modifiedisActedBy> ;
                                                  rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedActor> ;
                                                  rdfs:range <http://www.ime.usp.br/~renata/FOAF-modifiedMovie> ;
                                                  rdfs:label "acts" .


###  http://www.ime.usp.br/~renata/FOAF-modifieddepicts
<http://www.ime.usp.br/~renata/FOAF-modifieddepicts> rdf:type owl:ObjectProperty ;
                                                     rdfs:range owl:Thing ;
                                                     rdfs:comment "A thing depicted in this representation." ;
                                                     rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                     rdfs:label "depicts" ;
                                                     <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://www.ime.usp.br/~renata/FOAF-modifieddirects
<http://www.ime.usp.br/~renata/FOAF-modifieddirects> rdf:type owl:ObjectProperty ;
                                                     owl:inverseOf <http://www.ime.usp.br/~renata/FOAF-modifiedisDirectedBy> ;
                                                     rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedMovie> ;
                                                     rdfs:range <http://www.ime.usp.br/~renata/FOAF-modifiedDirector> ;
                                                     rdfs:label "directs" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedisActedBy
<http://www.ime.usp.br/~renata/FOAF-modifiedisActedBy> rdf:type owl:ObjectProperty ;
                                                       rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedMovie> ;
                                                       rdfs:range <http://www.ime.usp.br/~renata/FOAF-modifiedActor> ;
                                                       rdfs:label "isActedBy" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedisDirectedBy
<http://www.ime.usp.br/~renata/FOAF-modifiedisDirectedBy> rdf:type owl:ObjectProperty ;
                                                          rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedDirector> ;
                                                          rdfs:range <http://www.ime.usp.br/~renata/FOAF-modifiedMovie> ;
                                                          rdfs:label "isDirectedBy" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedknows
<http://www.ime.usp.br/~renata/FOAF-modifiedknows> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                   rdfs:range <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                   rdfs:comment "A person known by this person (indicating some level of reciprocated interaction between the parties)." ;
                                                   rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                   rdfs:label "knows" ;
                                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedmade
<http://www.ime.usp.br/~renata/FOAF-modifiedmade> rdf:type owl:ObjectProperty ;
                                                  owl:inverseOf <http://www.ime.usp.br/~renata/FOAF-modifiedmaker> ;
                                                  rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedAgent> ;
                                                  rdfs:range owl:Thing ;
                                                  rdfs:comment "Something that was made by this agent." ;
                                                  rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                  rdfs:label "made" ;
                                                  <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedmaker
<http://www.ime.usp.br/~renata/FOAF-modifiedmaker> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain owl:Thing ;
                                                   rdfs:range <http://www.ime.usp.br/~renata/FOAF-modifiedAgent> ;
                                                   rdfs:comment "An agent that  made this thing." ;
                                                   rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                   rdfs:label "maker" ;
                                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://www.w3.org/2002/07/owl#topObjectProperty
owl:topObjectProperty rdf:type owl:SymmetricProperty ,
                               owl:TransitiveProperty ,
                               owl:ReflexiveProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.ime.usp.br/~renata/FOAF-modifiedage
<http://www.ime.usp.br/~renata/FOAF-modifiedage> rdf:type owl:DatatypeProperty ,
                                                          owl:FunctionalProperty ;
                                                 rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedAgent> ;
                                                 rdfs:range rdfs:Literal ;
                                                 rdfs:comment "The age in years of some agent." ;
                                                 rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                 rdfs:label "age" ;
                                                 <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedbirthday
<http://www.ime.usp.br/~renata/FOAF-modifiedbirthday> rdf:type owl:DatatypeProperty ,
                                                               owl:FunctionalProperty ;
                                                      rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedAgent> ;
                                                      rdfs:range rdfs:Literal ;
                                                      rdfs:comment "The birthday of this Agent, represented in mm-dd string form, eg. '12-31'." ;
                                                      rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                      rdfs:label "birthday" ;
                                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "unstable" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedfamilyName
<http://www.ime.usp.br/~renata/FOAF-modifiedfamilyName> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                        rdfs:range rdfs:Literal ;
                                                        rdfs:comment "The family name of some person." ;
                                                        rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                        rdfs:label "familyName" ;
                                                        <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedfirstName
<http://www.ime.usp.br/~renata/FOAF-modifiedfirstName> rdf:type owl:DatatypeProperty ;
                                                       rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                       rdfs:range rdfs:Literal ;
                                                       rdfs:comment "The first name of a person." ;
                                                       rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                       rdfs:label "firstName" ;
                                                       <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedgender
<http://www.ime.usp.br/~renata/FOAF-modifiedgender> rdf:type owl:DatatypeProperty ,
                                                             owl:FunctionalProperty ;
                                                    rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedAgent> ;
                                                    rdfs:range rdfs:Literal ;
                                                    rdfs:comment "The gender of this Agent (typically but not necessarily 'male' or 'female')." ;
                                                    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                    rdfs:label "gender" ;
                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedlastName
<http://www.ime.usp.br/~renata/FOAF-modifiedlastName> rdf:type owl:DatatypeProperty ;
                                                      rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                      rdfs:range rdfs:Literal ;
                                                      rdfs:comment "The last name of a person." ;
                                                      rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                      rdfs:label "lastName" ;
                                                      <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "testing" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedlaunchDate
<http://www.ime.usp.br/~renata/FOAF-modifiedlaunchDate> rdf:type owl:DatatypeProperty ;
                                                        rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedMovie> ;
                                                        rdfs:range xsd:int ;
                                                        rdfs:comment "The date the movie premiered." ;
                                                        rdfs:label "launchDate" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedtitle
<http://www.ime.usp.br/~renata/FOAF-modifiedtitle> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain <http://www.ime.usp.br/~renata/FOAF-modifiedMovie> ;
                                                   rdfs:range xsd:string ;
                                                   rdfs:comment "Title of a movie." ;
                                                   rdfs:label "title" .


#################################################################
#    Classes
#################################################################

###  http://www.ime.usp.br/~renata/FOAF-modifiedActor
<http://www.ime.usp.br/~renata/FOAF-modifiedActor> rdf:type owl:Class ;
                                                   rdfs:subClassOf <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                   rdfs:label "Actor" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedAgent
<http://www.ime.usp.br/~renata/FOAF-modifiedAgent> rdf:type owl:Class ;
                                                   rdfs:comment "An agent (eg. person, group, software or physical artifact)." ;
                                                   rdfs:label "Agent" ;
                                                   <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedDirector
<http://www.ime.usp.br/~renata/FOAF-modifiedDirector> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://www.ime.usp.br/~renata/FOAF-modifiedPerson> ;
                                                      rdfs:label "Director" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedMovie
<http://www.ime.usp.br/~renata/FOAF-modifiedMovie> rdf:type owl:Class ;
                                                   rdfs:label "Movie" .


###  http://www.ime.usp.br/~renata/FOAF-modifiedPerson
<http://www.ime.usp.br/~renata/FOAF-modifiedPerson> rdf:type owl:Class ;
                                                    rdfs:subClassOf <http://www.ime.usp.br/~renata/FOAF-modifiedAgent> ,
                                                                    <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ;
                                                    rdfs:comment "A person." ;
                                                    rdfs:isDefinedBy <http://xmlns.com/foaf/0.1/> ;
                                                    rdfs:label "Person" ;
                                                    <http://www.w3.org/2003/06/sw-vocab-status/ns#term_status> "stable" .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdfs:label "Thing" .


###  http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing
<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> rdf:type owl:Class ;
                                                       rdfs:label "Spatial Thing" .


