# Multi-stage A100 GPU Optimization Dockerfile
# Optimized for NVIDIA A100-SXM4-40GB with CUDA 12.1 and TensorRT

FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04 as builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    git \
    wget \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

WORKDIR /build

# Copy requirements
COPY requirements.txt /build/

# Install Python dependencies for A100
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu121 \
    torch \
    torchvision \
    torchaudio && \
    pip install --no-cache-dir \
    tensorrt \
    polygraphy \
    numpy \
    tqdm \
    sentence-transformers \
    aiohttp

# Runtime stage
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Create non-root user
RUN useradd -m -u 1000 gpu-user && \
    mkdir -p /app/data/embeddings && \
    mkdir -p /app/results && \
    chown -R gpu-user:gpu-user /app

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages

# Copy application scripts
COPY scripts/server/mcp_server_http.py /app/scripts/server/
COPY scripts/server/gpu_recommend.py /app/scripts/server/
COPY scripts/server/run_recommendations.py /app/scripts/server/
COPY scripts/benchmarks/benchmark_hyper_personalization.py /app/scripts/benchmarks/
COPY scripts/benchmarks/test_a100_comprehensive.py /app/scripts/benchmarks/
COPY scripts/benchmarks/benchmark_a100.py /app/scripts/benchmarks/
COPY scripts/ops/deploy_and_test_a100.sh /app/scripts/ops/
COPY scripts/data_pipeline/ /app/scripts/data_pipeline/
COPY scripts/utils/ /app/scripts/utils/

# Copy data
COPY data/embeddings/media/ /app/data/embeddings/media/
COPY data/embeddings/users/ /app/data/embeddings/users/

# Copy requirements
COPY requirements.txt /app/

# Set permissions
RUN chown -R gpu-user:gpu-user /app

# Switch to non-root user
USER gpu-user

# Expose ports
EXPOSE 8888 9000

# Health check - verify GPU availability
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import torch; assert torch.cuda.is_available(), 'GPU not available'" || exit 1

# Default command - MCP server on A100
CMD ["python3", "scripts/server/mcp_server_http.py", "--host", "0.0.0.0", "--port", "8888"]
